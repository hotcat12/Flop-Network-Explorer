{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "https://flopexplore-hjrkkjcb.manus.space/api/trpc/:path*"
    },
    {
      "source": "/api/technocore/:path*",
      "destination": "https://technocore.chat/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
